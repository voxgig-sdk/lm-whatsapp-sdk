# BasicManageTemplateFlow

main: kit: flow: BasicManageTemplateFlow:
{
  entity: "manage_template",
  kind: "basic",
  name: "BasicManageTemplateFlow",
  step: [
    {
      i: {
        ref: "manage_template_ref01"
      }

      o: "create"
    }

    {
      i: {
        ref: "manage_template_ref01",
        srcdatavar: "manage_template_ref01_data",
        suffix: "_dt0"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-manage_template_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "manage_template_ref01",
        suffix: "_rm0"
      }

      m: {
        id: "manage_template01"
      }

      o: "remove"
    }
  ],
  "key$": "BasicManageTemplateFlow"
}