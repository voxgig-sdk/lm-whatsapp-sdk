# BasicTemplateFlow

main: kit: flow: BasicTemplateFlow:
{
  entity: "template",
  kind: "basic",
  name: "BasicTemplateFlow",
  step: [
    {
      input: {
        ref: "template_ref01"
      }

      op: "create"
    }

    {
      input: {
        ref: "template_ref01",
        srcdatavar: "template_ref01_data",
        suffix: "_up0",
        textfield: "category"
      }

      op: "update",
      spec: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-template_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicTemplateFlow"
}