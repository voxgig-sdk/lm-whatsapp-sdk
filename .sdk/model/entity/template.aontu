        [
          "`$STRING`"
          "`$NULL`"
        ]
      ]
    }
    language: {
      h: "Language"
      n: "language"
      r: false
      t: "`$STRING`"
    }
    message_send_ttl_seconds: {
      fo: "int32"
      h: "Message Send Ttl Seconds"
      n: "message_send_ttl_seconds"
