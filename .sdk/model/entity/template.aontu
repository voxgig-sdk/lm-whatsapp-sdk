          req: false
          type: [
            "`$ONE`"
            [
              "`$ARRAY`"
              "`$NULL`"
            ]
          ]
        }
      }
      req: true
      type: "`$ARRAY`"
    }
    {
      name: "created_date"
      req: false
      type: "`$STRING`"
    }
    {
      name: "id"
      req: false
      type: [
        "`$ONE`"
        [
          "`$STRING`"
          "`$NULL`"
        ]
      ]
    }
    {
      name: "language"
      op: {
        create: {
          req: true
          type: "`$STRING`"
        }
      }
      req: false
      type: "`$STRING`"
    }
    {
      name: "library_template_body_input"
      req: false
      type: "`$OBJECT`"
    }
    {
      name: "library_template_button_input"
      req: false
      type: [
        "`$ONE`"
        [
          "`$ARRAY`"
          "`$NULL`"
        ]
      ]
    }
    {
      name: "library_template_name"
      req: false
