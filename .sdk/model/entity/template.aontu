  }

  id: {
    field: "id"
    name: "id"
  }

  name: "template"
  op: {
    update: {
      name: "update"
      points: [
        {
          co: {
            id: "PUT /whatsapp/v2/templates/{id}"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "id"
                or: "id"
