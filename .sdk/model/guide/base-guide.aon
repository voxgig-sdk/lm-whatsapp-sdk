# Guide

guide: {
  metrics: count: entity: 6
  metrics: count: path: 4
  metrics: count: method: 7

  entity: manage_template: {
    path: "/whatsapp/v2/templates/{id}": {
      op: remove: method: *DELETE
    }
  }

  entity: media: {
    path: "/whatsapp/v2/{phoneNumber}/media": {
      rename: param: "phoneNumber": *"phone_number"
      op: create: method: *POST
    }
  }

  entity: send_message: {
    path: "/whatsapp/v2/messages": {
      op: create: method: *POST
    }
  }

  entity: template: {
    path: "/whatsapp/v2/templates": {
      op: create: method: *POST
      op: create: transform: req: "allow_category_change": *("`reqdata.allow_category_change`")|top
      op: create: transform: req: "category": *("`reqdata.category`")|top
      op: create: transform: req: "components": *("`reqdata.component`")|top
      op: create: transform: req: "language": *("`reqdata.language`")|top
      op: create: transform: req: "library_template_body_inputs": *("`reqdata.library_template_body_input`")|top
      op: create: transform: req: "library_template_button_inputs": *("`reqdata.library_template_button_input`")|top
      op: create: transform: req: "library_template_name": *("`reqdata.library_template_name`")|top
      op: create: transform: req: "message_send_ttl_seconds": *("`reqdata.message_send_ttl_second`")|top
      op: create: transform: req: "name": *("`reqdata.name`")|top
      op: create: transform: req: "parameter_format": *("`reqdata.parameter_format`")|top
      op: create: transform: req: "sub_category": *("`reqdata.sub_category`")|top
    }
    path: "/whatsapp/v2/templates/{id}": {
      op: update: method: *PUT
      op: update: transform: req: "category": *("`reqdata.category`")|top
      op: update: transform: req: "components": *("`reqdata.component`")|top
      op: update: transform: req: "message_send_ttl_seconds": *("`reqdata.message_send_ttl_second`")|top
      op: update: transform: req: "parameter_format": *("`reqdata.parameter_format`")|top
    }
  }

  entity: whats_app_template_get_v2: {
    path: "/whatsapp/v2/templates/{id}": {
      op: load: method: *GET
    }
  }

  entity: whats_app_template_get_v2_pagination: {
    path: "/whatsapp/v2/templates": {
      op: load: method: *GET
    }
  }

}